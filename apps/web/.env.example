# Your Convex deployment URL. `npm run dev:backend` prints it and saves it as CONVEX_URL
# in packages/backend/.env.local (local: http://127.0.0.1:3210, cloud: https://<name>.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=

# Optional: a TURN relay for voice chat in online rooms. Plain STUN works on most networks, but some
# mobile networks need a relay. Any TURN provider works (e.g. Twilio, Metered, Cloudflare, your own coturn).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
